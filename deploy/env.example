STACK_NAME=replace-with-existing-traefik-stack-name
APP_DOMAIN=it-da.app
ITDA_DATA_NODE_HOSTNAME=replace-with-data-node-hostname

TRAEFIK_NETWORK=proxy
TRAEFIK_CERT_RESOLVER=le
TRAEFIK_ACME_EMAIL=operator@example.com
TRAEFIK_DASHBOARD_DOMAIN=dashboard.example.com
TRAEFIK_WHOAMI_DOMAIN=whoami.example.com
TRAEFIK_DASHBOARD_USERS_FILE=/opt/traefik/dashboard-users
ITDA_GLM_DASHBOARD_BASIC_AUTH_USERS=replace-with-username-and-bcrypt-hash
TRAEFIK_IMAGE=traefik:v3.6
WHOAMI_IMAGE=traefik/whoami

BACKEND_IMAGE=pengginregistry.pengbot.app/itda/backend:replace-with-authenticity-image
WEB_IMAGE=pengginregistry.pengbot.app/itda/web:replace-with-authenticity-image
POSTGRES_IMAGE=docker.io/library/postgres:17.10-bookworm@sha256:4f736ae292687621d4dbe0d499ffd024a36bd2ee7d8ca6f2ccd4c800f047b394

ITDA_POSTGRES_DB=itda
ITDA_POSTGRES_ADMIN_USER=itda_admin
ITDA_POSTGRES_ADMIN_PASSWORD=replace-with-url-safe-random-secret

ITDA_RUNTIME_ROLE=itda_runtime
ITDA_RUNTIME_PASSWORD=replace-with-url-safe-random-secret
ITDA_LABEL_BUILDER_ROLE=itda_label_builder
ITDA_LABEL_BUILDER_PASSWORD=replace-with-url-safe-random-secret
ITDA_LABEL_APPROVER_ROLE=itda_label_approver
ITDA_LABEL_APPROVER_PASSWORD=replace-with-url-safe-random-secret

ITDA_PROFILE_RELEASE_AUTHORITY_SERVICE_PASSWORD=replace-with-url-safe-random-secret
ITDA_PHOTO_SERVICE_PASSWORD=replace-with-url-safe-random-secret
ITDA_PROFILE_SESSION_SERVICE_PASSWORD=replace-with-url-safe-random-secret
ITDA_DAILY_GLM_REFRESH_SERVICE_PASSWORD=replace-with-url-safe-random-secret
ITDA_PROFILE_SESSION_CURRENT_KID=current
ITDA_PROFILE_SESSION_KEYRING=current.replace-with-32-byte-base64url-key

ITDA_OPERATING_INFORMATION_ENABLED=0
TOUR_API_SERVICE_KEY=
ITDA_TOUR_API_SERVICE_KEY_SECRET=itda_tour_api_service_key
ITDA_OPERATING_INFORMATION_TIMEOUT_SECONDS=1.5
ITDA_OPERATING_INFORMATION_TTL_SECONDS=900
ITDA_OPERATING_INFORMATION_NEGATIVE_TTL_SECONDS=120

# Official collection remains stopped after the user-directed quota stop.
ITDA_GROUNDED_DAILY_REPLICAS=0
# Kept for a separately authorized maintenance run; never auto-start it.
# Legacy daily authority settings are not used by the production entrypoint.
ZHIPUAI_API_KEY=
ITDA_ZHIPUAI_API_KEY_SECRET=itda_zhipuai_api_key
ITDA_DAILY_GLM_REFRESH_SERVICE_PASSWORD_SECRET=itda_daily_glm_refresh_service_password
ITDA_DAILY_TOUR_API_TIMEOUT_SECONDS=15

# All new photo jobs use photo-mood-v1 (approximate visual mood only).
# glm-5.3-flash inference is enabled when configured; set 0 to disable inference.
# Uses ITDA_PHOTO_VLM_API_KEY(_FILE), otherwise ZHIPUAI_API_KEY / ITDA_ZHIPUAI_API_KEY_FILE.
# Disabled inference or a missing/invalid key reports unavailable and cleans up;
# the persisted mood family never falls back to M1–M6 trait analysis.
ITDA_PHOTO_MOOD_ENABLED=1
ITDA_PHOTO_VLM_API_KEY=
ITDA_PHOTO_VLM_API_KEY_FILE=
# Deprecated selectors are ignored by the production photo factory.
ITDA_PHOTO_VLM_ENABLED=0
ITDA_PHOTO_VLM_ENDPOINT=https://api.z.ai/api/coding/paas/v4/chat/completions
ITDA_PHOTO_VLM_MODEL=glm-5.3-flash
# Backend + daily worker share /var/lib/itda/model-sessions on the same host.
# Swarm's itda.data label must identify a single data node; local volumes do not
# coordinate the 5-session budget across hosts. Photo quarantine stays separate.

# Legacy online context and daily collection are disabled.
# The image contains the PUBLIC authenticity snapshot only.
# Previously installed legacy DB snapshots are preserved.
# Daily national sources use a separate /var/lib/itda/grounded-daily/national cache.
# One shared TourAPI key is reused. Optional ITDA_TOURISM_<SOURCE>_SERVICE_KEY(_FILE)
# overrides support ACCESSIBILITY, CONCENTRATION, VISITORS, DEMAND, CAMPING, WALKING, RELATED.
# Credentials are read in process and never appear in context/diagnostic output.
ITDA_TOURISM_ENABLED=0
ITDA_GROUNDED_RECOMMENDATIONS_ENABLED=0
# Explicit 0 stops the scheduler; it never selects the historical raw-only batch.
ITDA_GROUNDED_DAILY_ENABLED=0
ITDA_GROUNDED_DAILY_WORKERS=4
# For later daily candidate promotion, paths must be visible inside the daily volume.
ITDA_GROUNDED_DAILY_GATE_FILE=
ITDA_GROUNDED_DAILY_REPORT_DIR=
ITDA_TOURISM_HTTP_CONCURRENCY=3
ITDA_TOURISM_TIMEOUT_SECONDS=10
ITDA_TOURISM_MAX_ATTEMPTS=2
ITDA_TOURISM_FACILITY_TTL_SECONDS=86400
ITDA_TOURISM_TEMPORAL_TTL_SECONDS=21600
ITDA_TOURISM_NEGATIVE_TTL_SECONDS=900
ITDA_TOURISM_MAX_PAGES=40
ITDA_TOURISM_PAGE_SIZE=1000
# Calendar-based historical requests, not a claim that this is latest available data.
# Default: first day of the month 2 months earlier for visitors; that month for demand.
ITDA_TOURISM_REFERENCE_LAG_MONTHS=2
ITDA_TOURISM_VISITOR_START=
ITDA_TOURISM_VISITOR_END=
ITDA_TOURISM_DEMAND_MONTH=
# Blank uses 202504, the latest month documented by dataset15128560 as of 2026-09-09.
# Override after confirming availability of a newer related-tourism reference month.
ITDA_TOURISM_RELATED_MONTH=
# Latest user setting: at most 5 concurrent model requests (absolute safety ceiling40).
ITDA_TOURISM_MODEL=glm-5.3-flash
ITDA_MODEL_SESSION_LIMIT=5
ITDA_BATCH_MODEL_SESSIONS=4
ITDA_PHOTO_MODEL_SESSIONS=1

# Authenticity API: use the limited runtime role, never the installer/admin credential.
# The templates derive the authenticity DSN from the limited runtime credential.
# For an existing DB, set PREVIOUS to its exact active authenticity hash; NONE means empty.
ITDA_AUTHENTICITY_RELEASE_SHA256=bcd012c94cfd1fb66a2edbc3c3922d2e4dfa5438d7d4a86fc9e2f0049b0c79f7
ITDA_AUTHENTICITY_EXPECTED_PLACES=1984
ITDA_AUTHENTICITY_PREVIOUS_RELEASE_SHA256=NONE
ITDA_AUTHENTICITY_ALLOW_DEVELOPMENT=0
ITDA_AUTHENTICITY_PHOTO_ENABLED=1
