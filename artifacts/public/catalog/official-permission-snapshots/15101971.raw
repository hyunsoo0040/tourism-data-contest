 : 국문, en : 영문, cn1 : 중문간체 , jp : 일문)","paramtrTy":"string","paramtrDivision":"필수","ck":true},{"paramtrNm":"tid","paramtrBassValue":"","paramtrDc":"관광지아이디( key값으로 해당정보 조회시 tlid와 동시에 입력시 조회 가능함. )","paramtrTy":"string","paramtrDivision":"옵션","ck":true},{"paramtrNm":"tlid","paramtrBassValue":"","paramtrDc":"관광지언어아이디( key값으로 해당정보 조회시 tid와 동시에 입력시 조회 가능함. )","paramtrTy":"string","paramtrDivision":"옵션","ck":true},{"paramtrNm":"syncStatus","paramtrBassValue":"A","paramtrDc":"컨텐츠상태(A=신규,U=수정,D=삭제)","paramtrTy":"string","paramtrDivision":"옵션","ck":true},{"paramtrNm":"modifiedtime","paramtrBassValue":"","paramtrDc":"수정일 (형식 : YYYYMMDD)","paramtrTy":"string","paramtrDivision":"옵션","ck":true}],"resList":[{"paramtrNm":"header","paramtrDc":"header","paramtrDefNm":"#/definitions/storyBasedSyncList_header","subDefNm":"storyBasedSyncList_header","paramtrTy":"object","paramtrDivision":"필수","ck":true},{"paramtrNm":"body","paramtrDc":"body","paramtrDefNm":"#/definitions/storyBasedSyncList_body","subDefNm":"storyBasedSyncList_body","paramtrTy":"object","paramtrDivision":"필수","ck":true}]}]}`;
            const publicDataPk = '15101971';
            const mberId = '';
            mberTy = '';

            $.ajax({
                url: "/uim/cmm/selectMberInfo.json",
                type: "POST",
                data: {"mberId": mberId},
                dataType: "json",
                success: function (result) {
                    if(result.loginVO != null) {
                        mberTy = result.loginVO.mberTy;
                    }
                },
                error: function (err) {
                    // console.log(err);
                }
            });

            $("#confirmY").on("click", function() {
                apiRequestForm(mberTy, publicDataPk, 'Y');
            });

            $("#confirmN").on("click", function() {
                apiRequestForm(mberTy, publicDataPk, 'N');
            });

            let data = {
                deepLinking: true,
                presets: [
                    SwaggerUIBundle.presets.apis,
                    SwaggerUIStandalonePreset
                ],
                plugins: [
                    SwaggerUIBundle.plugins.DownloadUrl
                ],
                layout: "StandaloneLayout"
            };
            if(swaggerUrl !== '') {
                data.dom_id = '#swagger-ui';
                data.url = swaggerUrl;
            }
            if(swaggerJson !== '') {
                data.dom_id = '#api-swagger';
                data.spec = JSON.parse(swaggerJson);
            }
            window.ui = SwaggerUIBundle(data);
        }
    };

    function init() {
        fileDetailObj.mberId = '';

        const ext = "JSON+XML";
        $('.page-title-etc .file-ext-css').addClass(FileUtil.getCategoryClass(ext));

        const pk = "15101971";
        const dType = "api";
        const subject = "한국관광공사_관광지 오디오 가이드정보_GW";
        favorObj.addCookie(pk, dType, subject);


        fileDetailObj.fn_personalRecommendData(pk);
        fileDetailObj.fn_recommendData(pk);
        // 퀵 서머리
        executeSearch(pk);

        // 기업회원 활용신청시 종류 선택 모달
        // var businessMemberApiModal = Handlebars.getTemplate("business-member-api-modal");
        // $('#contents').append(businessMemberApiModal());
        // $("#data-type-recommendData").click();
    }

    function buttonEvent() {
        const $likeBtn = $('#likeBtn');
        const $hateBtn = $('#hateBtn');
        const publicDataPk = $("#publicDataPk").val();
        const $attentionRemoveBtn = $('#attentionRemoveBtn');
        const $attentionAddBtn = $('#attentionAddBtn');

        $attentionRemoveBtn.on('click', function() {
            fileDetailObj.fn_attentionUpdate();
        })

        $attentionAddBtn.on('click', function() {
            fileDetailObj.fn_attention('API');
        })

        $hateBtn.on('click', function() {
            let mbrId = ""
            fileDetailObj.fn_saveHate(this, publicDataPk,mbrId)
        })

        $likeBtn.on('click', function() {
            let mbrId = "";
            fileDetailObj.fn_saveLike(this, publicDataPk, mbrId);
        })


        $('#shortcut').on('click', function(e) {
            
            
            
                alert("로그인 후 이용가능합니다.");
                location.href = "/uim/login/loginView.do";
            
            
        });
    }

    const fn_selectApiDetailFunction = function () {
        let dataObj = {};

        dataObj.oprtinSeqNo = $("#open_api_detail_select").val();
        dataObj.publicDataDetailPk = $("#publicDataDetailPk").val();

        $.ajax({
            url: "/tcs/dss/selectApiDetailFunction.do",
            method: "post",
            data: dataObj,

            success: function (data) {
                $("#open-api-detail-result").remove();
                $("#apiDetailFunctionDiv").append(data);
            }
        })
    }

    // 활용신청
    const fn_goOpenAPIRequestForm = function (publicDataPk) {

        const loginId = "";
        const mberCategory = "";
        const isCorpApi = "N";
        const mberAuthor = ""
        let isBusinessApply;
        const mberSttus = "";

        console.log("loginId = " + loginId)
        console.log("isCorpApi = " + isCorpApi)
        console.log("mberTy = " + mberTy)

        if (fn_empty(loginId)) {

            if (confirm("로그인이 필요한 서비스입니다.\n로그인 페이지로 이동하시겠습니까?")) {
                location.href = '/uim/login/loginView.do';
                return;
            } else {
                return;
            }
        }

        //개인회원일 경우 기업회원 활용신청 불가 및 기업회원 전환 진행
        if (isCorpApi == "Y" && mberTy == "MBTY01") {
            alert("기업회원이 아닐 경우 해당 API 활용신청이 불가능합니다.");
            if (confirm("기업회원 가입을 진행하시겠습니까?")) {
                location.href = "/iim/miu/corpInsertView.do";
            }
            return;
        }

        // // 기업회원의 경우 개인 서비스키를 사용할 건지 프로젝트 키 사용할건지에 대한 유무
        if(mberCategory == 'BUSINESS' && mberSttus === 'MBST01') {
            krds_modal.openModal('business-select-modal');
            return;
        }

        fn_setCookie("currentMyMenuId", "M020105", 1);
        window.open("/tcs/dss/redirectDevAcountRequestForm.do?publicDataPk=" + publicDataPk + "&isBusinessApply=" + isBusinessApply, "_blank");
        $(".recommend-after-download").slideDown();
    }

    // 프로젝트 서비스키
    function apiRequestForm(mberTy, publicDataPk, isBusinessApply) {
        fn_setCookie("currentMyMenuId", "M020105", 1);
        window.open("/tcs/dss/redirectDevAcountRequestForm.do?publicDataPk=" + publicDataPk + "&isBusinessApply=" + isBusinessApply, "_blank");
        $(".recommend-after-download").slideDown();
    }


    const fn_list = function () {
        // history.back();
        const recmYn = "";
        if(window.location.search.includes("dataMap")){
            window.close();
        }
        if (recmYn === "Y") {
            $("#listFrm").attr("action", "/tcs/dss/recommendDataList.do");
        }

        $("#listFrm").submit();
    }

    //링크 API 바로가기 : 제공처 URL 조회 후 새창 이동
    const fn_goUrlLink = function (publicDataPk) {

        $.ajax({
            url: "/tcs/dss/selectApiLinkUrl.do",
            data: {"publicDataPk": publicDataPk},

            success: function (data) {
                var jsonObj = JSON.parse(data);

                if (jsonObj.status === true) {
                    var openNewWindow = window.open("about:blank");

                    openNewWindow.location.href = jsonObj.linkUrl;
                    fn_LinkApiRequest(jsonObj.publicDataDetailPk);
                } else {
                    alert(jsonObj.errorDc);
                }
            }
        })
    }

    //2021-01-08 링크 API일 경우 바로가기 버튼 클릭시 활용신청 INSERT(NIA 요청사항)
    const fn_LinkApiRequest = function (publicDataDetailPk) {

        $.ajax({
            url: "/tcs/dss/addApiLinkPrcuse.do",
            type: "POST",
            data: {"param": publicDataDetailPk},
            error: function (err) {
                // console.log(err);
            }
        });
        $(".recommend-after-download").slideDown();
    }

    const fn_openWin = function (url) {
        window.open(url, "국가중점 API 새창 열기", "width=1200 , height=800");
    }

    /**
     * 페이스북 공유하기 위한 param값 설정
     */
    function fn_SetParamSns(ty){
        //게시물의 key값 이름
        var key = new Array();
        //게시물의 key값 value
        var value = new Array();
        var originIdVal = $("#publicDataPk").val();

        key.push("publicDataPk");
        value.push(originIdVal);
        //공통함수 호출
        fn_ShareSns(key,value,ty);
    }

    var fn_urlCopy = function() {
        var t = document.createElement("textarea");
        document.body.appendChild(t);
        t.value = window.location.href;
        t.select();
        document.execCommand('copy');
        document.body.removeChild(t);

        alert("URL이 복사되었습니다.");
    }
</script>
                            </div>
