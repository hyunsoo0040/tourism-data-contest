		</div>
        
    <!-- modal : 자동등록방지 p00-025 -->
    <section id="fileLimitCheck" class="modal-captcha krds-modal fade" role="dialog" aria-labelledby="fileLimitCheck">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <!-- modal title -->
                <div class="modal-header">
                    <h2 class="modal-title">자동등록방지</h2>
                </div>
                <!-- //modal title -->
                <!-- modal contents -->
                <div class="modal-conts">
                    <div class="conts-area">
                        <div class="fieldset">
                            <div class="form-group">
                                <div class="captcha-wrap">
                                    <div class="captcha-box">
                                        <img id="captchaImg" alt="보안문자" src="/captcha">
                                        <div class="btn-group">
                                        	<input type="hidden" id="limitAtchFileId" name="limitAtchFileId">
                                        	<input type="hidden" id="limitFileDetailSn" name="limitFileDetailSn">
                                            <button type="button" onclick="fn_captchaImgRefresh('captchaImg');" class="krds-btn text small"><i class="svg-icon ico-reset"></i> 새로고침</button>
                                            <button type="button" onclick="audio();" id="soundOn" class="krds-btn text small"><i class="svg-icon ico-sound"></i> 음성듣기</button>
                                        </div>
                                    </div>
                                    <div class="form-conts">
                                        <label for="captchaCmm"><input type="text" id="captchaCmm" name="captcha" class="krds-input" placeholder="보안문자를 입력하세요" maxlength="15"></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- //modal contents -->
                 <!-- modal btn -->
                <div class="modal-btn btn-wrap">
                    <button type="button" onclick="closeFileLimitModal();" class="krds-btn medium tertiary close-modal">닫기</button>
                    <button type="button" onclick="checkCaptcha();" class="krds-btn medium primary close-modal">확인</button>
                </div>
                <!-- //modal btn -->
                <!-- close button -->
                <button type="button" onclick="closeFileLimitModal();" class="krds-btn medium icon btn-close close-modal">
                    <span class="sr-only">닫기</span>
                    <i class="svg-icon ico-popup-close"></i>
                </button>
                <!-- //close button -->
            </div>
        </div>
        <div class="modal-back"></div>
    </section>
    <!-- //modal -->
    
    <script>
    function closeFileLimitModal() {
    	$('#fileLimitCheck').removeClass('show');
    	$('#fileLimitCheck').removeClass('in');
    }
    
    function checkCaptcha() {
    	
    	if ($('#captchaCmm').val().trim() === '') {
    		alert('자동등록 방지 문자를 입력해주세요.');
    		$('#captchaCmm').focus();
    		return;
    	}
    	
    	if (fn_compareCaptCha('captchaCmm')) {
    		$.ajax({
    			url: '/cmm/cmm/check-reset.json',
    			type: 'POST',
    			dataType: 'json',
    			data: {
    				atchFileId: $('#limitAtchFileId').val(),
    				fileDetailSn: $('#limitFileDetailSn').val()
    			},
    			success: function(res) {
    				if (res.success) {
    					alert("인증이 완료되었습니다. 다시 다운로드 시도해주세요.");		
    				} else {
    					alert('처리 중 오류가 발생했습니다. 다시 시도해 주십시오.');
    				}
					closeFileLimitModal();
    			},
    			error: function(xhr) {
    				alert('장애가 발생했습니다. 다시 시도해 주십시오.');
    			}
    		});
			
    	} else {
    		alert("인증에 실패했습니다.");
    		closeFileLimitModal();
    	}
    }
    </script>
	</body>
</html>
