                        <dd><a href="#!" onclick="window.open('http://odf.or.kr', '_blank')" class="link" target="_blank" title="새창으로 이동">오픈데이터 포럼<i class="svg-icon ico-link"></i></a></dd>
                    </dl>
                </div>
            </div>
            <button type="button" class="krds-btn xlarge icon total-menu-close-btn">
                <span class="sr-only">전체메뉴 닫기</span>
                <i class="svg-icon ico-popup-close"></i>
            </button>
        </div>
    </div>
</header>







 


    <script>
        var anyidAdaptor = anyidAdaptor || {};
        
        function checkPopupBlocked(popupWindow) {
        	if (!popupWindow || popupWindow.closed || typeof popupWindow.closed === 'undefined') {
        		// 차단되었을 경우 안내 메시지 출력
                alert(
                    "팝업이 차단되어 있습니다.\n" +
                    "브라우저 주소창 우측의 '팝업 차단' 아이콘을 클릭하여\n" +
                    "항상 허용으로 변경한 후 다시 시도해주세요."
                );
        		return true; // 차단됨
        	}
        	return false; // 혀용됨
        }

        /*이용기관 수정 영역 Start*/
        // 모바일 신분증 로그인 처리 (Any-ID SSO 미지원 / 토글 off 케이스)
        // 1) /login/orgLogin.jsp 호출하여 ssob 복호화 + CI 추출
        // 2) 서버에서 CI 기반으로 회원조회 후 redirectUrl 을 내려준다
        //    - 회원 존재  : /sso/sso-cert (PortalSsoUtil.getSsoApiUrl) 로 이동
        //    - 회원 없음  : 통합 로그인 페이지 + linkToken 으로 이동
        // 3) 클라이언트는 응답으로 받은 redirectUrl 로 location 이동
        anyidAdaptor.orgLogin = function(data){
            //정부 통합인증SDK_연계가이드 4.4.1.3 이용기관 로그인(토글 off) 참조
            //제공되는 라이브러리 메소드로 인증데이터 decrypt 이후 자체 로그인 로직 개발
            const params = new URLSearchParams(location.search);
            var obj ={
                ssob : data.ssob
                , extb : data.extb
                , tag : params.get("tx")
            }

            var xhr = new XMLHttpRequest();
            xhr.open("POST", "/login/orgLogin.jsp", true);
            xhr.setRequestHeader("Content-Type", "application/json");
            xhr.onreadystatechange = function() {
                if (xhr.readyState === 4 && xhr.status === 200) {
                    var response;
                    try {
                        response = JSON.parse(xhr.responseText);
                    } catch (e) {
                        alert("로그인 처리 중 오류가 발생했습니다.");
                        return;
                    }

                    
                    if (response.status === "success" && response.redirectUrl) {
                        window.location.href = response.redirectUrl;
                    } else {
                        alert(response && response.sResult ? response.sResult : "로그인 처리 중 오류가 발생했습니다.");
                    }
                }
            };
            xhr.send(JSON.stringify(obj));

        }
        /*이용기관 수정 영역 End*/
        
        
        /*이용기관 문구수정 영역 Start*/
        anyidAdaptor.JoinConfirm = function(portalJoinUri, memberData){
            if(!confirm('Any-ID 사용자등록 하시겠습니까?')) {
                anyidAdaptor.orgLogin(anyidAdaptor.certData);
                return;
            }else{
                anyidAdaptor.receiveAnyIdJoin(portalJoinUri, memberData);
            }
        }
        /*이용기관 문구수정 영역 End*/
        
        
        

        anyidAdaptor.portalJoinUri = "null";
        anyidAdaptor.certData = null;
        anyidAdaptor.ssoByPass = "0";
        anyidAdaptor.niRegYn = "null";
        anyidAdaptor.agencyContextPath = "";
        
        
        // [보안] 로그인 페이지를 연 지 오래되면 ssoInfo(OIDC 세션값)가 만료되어 /oidc/ssoLogin 이 실패할 수 있음.
        // anyidAdaptor.jsp는 공통 레이아웃에도 include되므로 전역 타이머는 쓰지 않고, 실제 로그인 시도(success) 시점에만 검사한다.
        anyidAdaptor.pageLoadedAt = anyidAdaptor.pageLoadedAt || Date.now();
        anyidAdaptor.SSO_STALE_LIMIT_MS = 10 * 60 * 1000; // 필요 시 ssoInfo 쿠키/세션 TTL 에 맞춰 조정
        anyidAdaptor.isStale = function(){
            return (Date.now() - anyidAdaptor.pageLoadedAt) > anyidAdaptor.SSO_STALE_LIMIT_MS;
        };
        anyidAdaptor.showStaleAndReload = function(){
            if(document.getElementById('anyidStaleModal')) return;
            var wrap = document.createElement('div');
            wrap.id = 'anyidStaleModal';
            wrap.style.cssText = 'position:fixed;inset:0;z-index:100020;';
            wrap.innerHTML =
                '<div style="position:absolute;inset:0;background:rgba(0,0,0,.5);"></div>' +
                '<div style="position:relative;max-width:420px;margin:0 auto;top:50%;transform:translateY(-50%);background:#fff;border-radius:8px;padding:32px 28px 24px;box-shadow:0 8px 30px rgba(0,0,0,.25);text-align:center;">' +
                '<p style="font-size:15px;line-height:1.6;color:#333;margin:0 0 24px;">로그인 페이지를 연 지 오래되었습니다.<br/>보안을 위해 새로고침 후 다시 로그인해 주세요.</p>' +
                '<button type="button" id="anyidStaleOk" style="min-width:120px;padding:12px 20px;border:0;border-radius:6px;background:#0b6efd;color:#fff;font-size:15px;font-weight:600;cursor:pointer;">확인</button>' +
                '</div>';
            document.body.appendChild(wrap);
            document.getElementById('anyidStaleOk').addEventListener('click', function(){ location.reload(); });
        };

        anyidAdaptor.success = function(data){
            if(anyidAdaptor.ssoByPass != 0 || !data.useSso) {
                anyidAdaptor.orgLogin(data);
            } else {
                if(anyidAdaptor.isStale && anyidAdaptor.isStale()){ // 페이지를 연 지 오래됨 → ssoInfo 만료 가능, 안내 후 새로고침
                    anyidAdaptor.showStaleAndReload();
                    return;
                }
                anyidAdaptor.certData = data;
                anyidAdaptor.userCheck();
            }
        }
        
        anyidAdaptor.userCheck = function(){
            var xhr = new XMLHttpRequest();
            xhr.open("POST", anyidAdaptor.agencyContextPath + "/oidc/userCheck", true);
            xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");

            xhr.onreadystatechange = function() {
                if (xhr.readyState === 4 && xhr.status === 200) {
                    var response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        anyidAdaptor.ssoLogin();
                    } else {
                        setTimeout(function() {
                            anyidAdaptor.receiveAnyIdJoin(response.uri, response.data);
                        }, 100);  
                    }
                }
            };

            let jsonObject = new Object();
            jsonObject.txId = anyidAdaptor.certData.txId;
            jsonObject.ssob = anyidAdaptor.certData.ssob;
            jsonObject.userSeCd = anyidAdaptor.certData.userSeCd;
            
            let jsonStr = JSON.stringify(jsonObject);
            let encodedString = btoa(jsonStr);
            
            var data = "data=" + encodedString + "&txId=" + anyidAdaptor.certData.txId;
            xhr.send(data);
            
        }

        //anyid가입
        // [요구사항] 정부통합인증 등록 팝업 처리:
        //  - 등록+약관동의 완료(status=="success" && trmsAgreYn=="Y")일 때만 로그인(ssoLogin)
        //  - 그 외(등록 안 함/약관 미동의/알 수 없는 응답/창 닫기)는 로그인하지 않고 안내 팝업 표출 후 현재 페이지 유지
        anyidAdaptor.receiveAnyIdJoin = function(portalJoinUri, memberData){

            var url = portalJoinUri+encodeURIComponent(memberData);
            var joinPopup = anyidAdaptor.popup(url,"openAnyIdRegistUserIdv",700,740);

            var handled = false;
            var closeTimer = null;

            function cleanup(){
                window.removeEventListener("message", onMessage, false);
                if(closeTimer){ clearInterval(closeTimer); closeTimer = null; }
            }
            function onRegistSuccess(){
                if(handled) return; handled = true; cleanup();
                anyidAdaptor.ssoLogin();
            }
            function onRegistFail(){
                if(handled) return; handled = true; cleanup();
                anyidAdaptor.showRegistRequired(); // 안내 팝업만 표출, 로그인/이동하지 않음 → 현재 페이지 유지
            }

            function onMessage(event){
                var result;
                try {
                    result = JSON.parse(event.data);
                } catch (error) {
                    return; // 우리 규격 아님 → 무시
                }
                if(!result.funcName || (result.funcName !== "trmsAgreComplete" && result.funcName !== "registUserComplete")) {
                    return; // 관련 없는 메시지 무시(창 닫기는 아래 타이머가 별도 감지)
                }
                // 등록+약관동의 완료만 통과, 나머지는 전부 안내
                if(result.status === "success" && result.trmsAgreYn == "Y"){
                    onRegistSuccess();
                } else {
                    onRegistFail();
                }
            }
            window.addEventListener("message", onMessage, false);

            // 창 닫기(X) 등 postMessage 없이 종료되는 경우 감지: 성공 없이 팝업이 닫히면 '등록 안 함'으로 간주
            if(joinPopup){
                closeTimer = setInterval(function(){
                    if(joinPopup.closed){ onRegistFail(); }
                }, 500);
            }
        }

        // [요구사항] 정부통합인증 미등록/등록거부 안내 팝업 (로그인하지 않고 현재 페이지 유지)
        anyidAdaptor.showRegistRequired = function(){
            if(document.getElementById('anyidRegistModal')) return;
            var wrap = document.createElement('div');
            wrap.id = 'anyidRegistModal';
            wrap.style.cssText = 'position:fixed;inset:0;z-index:100020;';
            wrap.innerHTML =
                '<div style="position:absolute;inset:0;background:rgba(0,0,0,.5);"></div>' +
                '<div style="position:relative;max-width:440px;margin:0 auto;top:50%;transform:translateY(-50%);background:#fff;border-radius:8px;padding:32px 28px 24px;box-shadow:0 8px 30px rgba(0,0,0,.25);text-align:center;">' +
                '<h2 style="font-size:18px;font-weight:700;margin:0 0 14px;color:#1a1a1a;">정부통합인증 사용자 등록 안내</h2>' +
                '<p style="font-size:15px;line-height:1.6;color:#444;margin:0 0 24px;">이용기관 서비스를 이용하시려면 정부통합인증 사용자 등록이 필요합니다.<br/>정부통합인증 사용자 등록 후 이용해 주시기 바랍니다.</p>' +
                '<button type="button" id="anyidRegistOk" style="min-width:120px;padding:12px 20px;border:0;border-radius:6px;background:#0b6efd;color:#fff;font-size:15px;font-weight:600;cursor:pointer;">확인</button>' +
                '</div>';
            document.body.appendChild(wrap);
            document.getElementById('anyidRegistOk').addEventListener('click', function(){
                var m = document.getElementById('anyidRegistModal');
                if(m && m.parentNode){ m.parentNode.removeChild(m); }
            });
        }

        // 팝업 호출
        anyidAdaptor.popup = function(url, name, width, height){
            let left = (screen.width) ? (screen.width-width)/2 : 0;
            let top = (screen.height) ? (screen.height-height)/2 : 0;
            let popup = window.open(url, name ,"resizable=yes,toolbar=no,scrollbars=yes,location=no,top="+top+"px,left="+left+"px,width="+width+"px,height="+height+"px");
            if (!checkPopupBlocked(popup)) {
                popup.focus();
            }
            return popup;
        }

        anyidAdaptor.ssoLogin = function(){
            let jsonObject = new Object();
            jsonObject.txId = anyidAdaptor.certData.txId;
            jsonObject.ssob = anyidAdaptor.certData.ssob;
            jsonObject.userSeCd = anyidAdaptor.certData.userSeCd;
            jsonObject.afData = anyidAdaptor.certData.afData;
            let jsonStr = JSON.stringify(jsonObject);
            
            let encodedString = btoa(jsonStr);
            var baseUrl = window.location.origin + anyidAdaptor.agencyContextPath + "/oidc/ssoLogin";
            var urlWithParams = baseUrl + "?data=" + encodedString;
            window.location.href = urlWithParams;
            
        }
        
        anyidAdaptor.ssoLoginPageSub = function(baseUrl, endPoint, acrValues){

            var subUrl = "";
            
            if (endPoint && endPoint.trim() !== "") {
            	sessionStorage.setItem('returnUrl', endPoint);
            	console.log("returnUrl 저장 : {}", endPoint);
                subUrl = "?endPoint=" + encodeURIComponent(endPoint);
            }
            
            if (!acrValues && acrValues.trim() == "") {
                acrValues = "3";
            }
            
            if (acrValues && acrValues.trim() !== "") {
                if(subUrl == ""){
                    subUrl = "?";
                }else{
                    subUrl = subUrl + "&";
                }
                subUrl = subUrl + "acrValues=" + acrValues;
            }
            
            window.location.replace(baseUrl+subUrl);
        }
        
        /**/
        anyidAdaptor.ssoLogout = function(endPoint) {
            endPoint = typeof endPoint !== 'undefined' ? endPoint : "/";
            var baseUrl = window.location.origin + anyidAdaptor.agencyContextPath + "/oidc/ssoLogout";
            baseUrl = baseUrl + "?endPoint=" + encodeURIComponent(endPoint);
            window.location.replace(baseUrl);
        }
        /**/
        anyidAdaptor.reAuthLevel = function(endPoint, acrValues){
            endPoint = typeof endPoint !== 'undefined' ? endPoint : "/";
            var baseUrl = window.location.origin + anyidAdaptor.agencyContextPath + "/oidc/reAuthLevel";
            anyidAdaptor.ssoLoginPageSub(baseUrl, endPoint, acrValues);

        }
        /**/
        anyidAdaptor.ssoLoginPage = function(endPoint, acrValues){
            endPoint = typeof endPoint !== 'undefined' ? endPoint : "/";
            var baseUrl = window.location.origin + anyidAdaptor.agencyContextPath + "/oidc/auth";
            anyidAdaptor.ssoLoginPageSub(baseUrl, endPoint, acrValues);
        }
        
        /**/
        anyidAdaptor.ssoSvcToSvc = function(url, endPoint){
            var baseUrl = url + "/oidc/svcToSvc?endPoint=" + encodeURIComponent(endPoint);
            const ssoPopup = window.open(baseUrl, "_blank");
            if (!checkPopupBlocked(ssoPopup)) {
            	ssoPopup.focus();
            }
        }


    </script>

<script>

    /** document Ready **/
    $(document).ready(function () {
        //현재메뉴 표시
        let currentMainMenuId = fn_getCookie("currentMainMenuId");
        setMenu(currentMainMenuId);

        window.addEventListener("resize", function () {
            let currentMainMenuId = fn_getCookie("currentMainMenuId");

            if (!fn_empty(currentMainMenuId)) {
                // HTTP_RESPONSE_SPLITTING 오류 처리
                currentMainMenuId = currentMainMenuId.replace(/.*(?=#[^\s]+$)/, '');
                if ($(window).width() <= 1024) {
                    currentMainMenuId = currentMainMenuId.replace("_pc", "_mb").replaceAll("[\\r\\n]", "");//replace(/\n|\r/g,"");

                    fn_setCookie("currentMainMenuId", currentMainMenuId,1);
                } else {
                    currentMainMenuId = currentMainMenuId.replace("_mb", "_pc").replaceAll("[\\r\\n]", "");//replace(/\n|\r/g,"");
                    fn_setCookie("currentMainMenuId", currentMainMenuId,1);
                }
                setMenu(currentMainMenuId);
            }
        })

        function setMenu(currentMainMenuId) {
            if (!fn_empty(currentMainMenuId)) {
                $("#" + currentMainMenuId).addClass("active");
                if (currentMainMenuId != undefined || currentMainMenuId != 'M0000000000') {
                    $("#" + currentMainMenuId).addClass("on");
                }
                $('#'+currentMainMenuId).closest('.upperMenu').addClass('active')
                if (currentMainMenuId != undefined || currentMainMenuId != 'M0000000000') {
                    $('#'+currentMainMenuId).closest('.upperMenu').addClass('on')
                }
                // $("#" + currentMainMenuId).parent().parent().parent().parent().addClass("active");
                // if (currentMainMenuId != undefined || currentMainMenuId != 'M0000000000') {
                //     $("#" + currentMainMenuId).parent().parent().parent().parent().addClass("on");
                // }
                if (currentMainMenuId.includes("M02")) { // 마이페이지 관련 하부 메뉴
                    $("#" + currentMainMenuId).parent().parent().parent().parent().parent().addClass("active");
                    $("#" + currentMainMenuId).parent().parent().prev().addClass("active");
                    $("#" + currentMainMenuId).parent().parent().parent().parent().prevAll().addClass("active");
                    $("#" + currentMainMenuId).parent().parent().parent().parent().parent().parent().parent().addClass("active");
                }
            } else {
                $("#gnb").find(".active").each(function (idx, entry) {
                    $(this).removeClass("active");
                });
                $(".gnb-mb").find(".depth2").slideUp(1, 'easeInOutExpo');
                $(".gnb-mb").find(".depth3").slideUp(1, 'easeInOutExpo');
                $(".gnb-mb").find(".depth4").slideUp(1, 'easeInOutExpo');
            }

            //하위메뉴 없는 경우 불필요한 태그 삭제
            $(".ulLower").each(function (idx, entry) {
                if ($(this).find("li").length === 0) {
                    $(this).parent().parent().remove();
                }
            });

        }
    });

    // function linkPage(obj, memnuId, menuUrl) {
    //     if (fn_empty(menuUrl)) return;
    //     if (menuUrl == "/") {
    //         alert("서비스 준비중입니다.");
    //         return;
    //     }
    // }

    /**
     * 페이지 이동
     * @param  : menuId - 메뉴 ID
     * @param  : menuUrl - 이동 menuUrl
     * @return : 없음
     */
    function fn_movePage(obj, menuId, menuUrl) {
        if (fn_empty(menuUrl)) return;

        // console.log("???")
        // console.log($(obj).closest('.gnb-toggle-wrap').value)
        // console.log($(obj).closest('.gnb-main-trigger'))
        //상위메뉴가 아닌 경우만 URL 호출
        if ($(obj).prop("class") != "upperMenu") {
            if (menuUrl == "/") {
                alert("서비스 준비중입니다.");
                return;
            }

            fn_setCookie("currentMainMenuId", menuId, 1);
            menuId = menuId.replace("_mb","")
            fn_setCookie("currentMyMenuId", menuId, 1);
            if (menuUrl == "/ssoMyPage") {
                getMypageUrl();
                return;
            } else {
                document.location.href = menuUrl;

            }
            //상위메뉴면서 하위메뉴가 없는 경우, URL 호출
        } else {
            if ($(obj).next().length == 0) {
                if (menuUrl == "/") {
                    alert("서비스 준비중입니다.");
                    return;
                } else {
                    fn_setCookie("currentMainMenuId", menuId, 1);
                    menuId = menuId.replace("_mb","")
                    fn_setCookie("currentMyMenuId", menuId, 1);

                    if (menuUrl == "/ssoMyPage") {
                        getMypageUrl();
                        return;
                    } else {
                        document.location.href = menuUrl;

                    }

                }

            }
        }
    }

    function getMypageUrl() {
        $.ajax({
            url		: "/iim/api/myPageUrl.do",
            success	: function(data) {
                var jsonObj	= JSON.parse(data);
                //console.log(jsonObj);
                if(jsonObj.result) {
                    location.href = jsonObj.url;
                } else {
                    alert("마이페이지로 이동 할 수 없습니다. 문제가 계속 될 경우 관리자에게 문의하여 주세요.");
                }
            }
        })
    }

    function moveMyPage() {
        window.location = '/iim/main/mypageMain.do';
    }

    function procLogin() {
   	
		
		
		const currentUrl = window.location.href;
		
		anyidAdaptor.ssoLoginPage(currentUrl,"");
		
	
    }

    function procLogout() {
   	
		
		
		anyidAdaptor.ssoLogout('/uim/login/actionLogout.do');
		
	
    }
</script>

            
                
                
                    <div class="wrap">
                        <div class="inner ">
                            
                            <div id="contents">
                                
									
										
										
											






 <script type="text/javascript">

	/**
	 * document Ready
	 */
	$(document).ready(function(){

		// ① URL → 브레드크럼 매핑 테이블 (string: 완전일치 / regex: 패턴매칭)
		var breadCrumbMap = [
			// 완전일치
			{ pattern: "/tcs/dss/selectDataSetList.do",                 crumb: ["홈", "공공데이터", "데이터 목록"] },
			{ pattern: "/tcs/dss/hybridSearch.do",                      crumb: ["홈", "공공데이터", "하이브리드 검색"] },
