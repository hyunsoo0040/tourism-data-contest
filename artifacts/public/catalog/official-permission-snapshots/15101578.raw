    </div>
    <div class="modal-back"></div>
</section>
<!-- //modal -->
<script>
    (function() {
        var modal = document.getElementById("business-select-modal");
        if (!modal) return;

        if (modal.parentNode !== document.body) {
            document.body.appendChild(modal);
        }

        modal.addEventListener("click", function(event) {
            if (!event.target.closest(".close-modal")) return;
            if (typeof krds_modal !== "undefined" && krds_modal.closeModal) {
                krds_modal.closeModal("business-select-modal");
            }
        });
    })();
</script>

