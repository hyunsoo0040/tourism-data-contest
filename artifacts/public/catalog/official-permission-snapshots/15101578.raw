                            <dd><a href="javascript:procLogin()" class="link menu-link">로그인<i class="svg-icon ico-angle right"></i></a></dd>
                        
                        
                    </dl>
                    <dl>
                        <dt>바로가기 링크</dt>
                        <dd><a href="#!" onclick="fn_movePage(this,'M0007010000_pc','/odsc/intro/index.do')" class="link menu-link">공공데이터전략위원회<i class="svg-icon ico-angle right"></i></a></dd>
                        <dd><a href="#!" onclick="fn_movePage(this,'M0007010000_pc','/odmc/intro/index.do')" class="link menu-link">공공데이터분쟁조정위원회<i class="svg-icon ico-angle right"></i></a></dd>
                        <dd><a href="#!" onclick="fn_movePage(this,'M0003070000_pc','/suc/startup.do')" class="link menu-link">공공데이터 활용 창업경진대회<i class="svg-icon ico-angle right"></i></a></dd>
                        <dd><a href="#!" onclick="fn_movePage(this,'M0003070000_pc','/osd/opensquare.do')" class="link menu-link">공공데이터 지원 오픈스퀘어-D<i class="svg-icon ico-angle right"></i></a></dd>
                        <dd><a href="#!" onclick="window.open('http://odf.or.kr', '_blank')" class="link" target="_blank" title="새창으로 이동">오픈데이터 포럼<i class="svg-icon ico-link"></i></a></dd>
