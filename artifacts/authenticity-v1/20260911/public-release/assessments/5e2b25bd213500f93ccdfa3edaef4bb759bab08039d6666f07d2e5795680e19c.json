          ],
          "key": "E.b",
          "level": 2,
          "reason": "이 장소의 이미지가 전국적으로 알려져 있다는 명시적 언급으로 매체 통한 확산의 기초 근거가 있다. 구체적 매체·작품·반복 표현의 근거는 없어 2단계로 판단했다.",
          "state": "SUPPORTED"
        },
        "review": {
          "decision": "REJECTED",
          "issues": [
            "UNSUPPORTED_INFERENCE"
          ],
          "key": "E.b",
          "reason": "'전국에 알려져 있기도 하다'는 단순 유명세 표현일 뿐, 확인된 작품·홍보·SNS 등 구체적 매체 표현의 근거가 없다. 유명세를 매체를 통한 이미지 유통으로 확대한 것으로 수준 2를 뒷받침하지 않는다."
        }
