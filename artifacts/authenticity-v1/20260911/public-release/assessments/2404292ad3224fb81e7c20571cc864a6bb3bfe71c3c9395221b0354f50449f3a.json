          "response_sha256": "ffd19c35ec2fc301c391b58368c162ca0f09008fa681f3606e27173e8d78eeeb",
          "retrieved_at": "2026-09-10T17:13:48.049186Z",
          "schema_version": "authenticity-receipt.v1",
          "source_modified_at": "2026-03-13T04:44:47Z",
          "source_record_sha256": "8a07a62705c8c5d8d21ff46c88c72d816435c77dc901dab41829fb408f4f9351",
