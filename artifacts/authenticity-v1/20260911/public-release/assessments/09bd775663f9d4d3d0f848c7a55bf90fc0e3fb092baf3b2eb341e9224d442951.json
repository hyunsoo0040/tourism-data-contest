        "text": "국학원-한민족역사문화공원-흑성산(519m)-독립기념관"
      },
      {
        "appearance": null,
        "evidence_id": "evidence:7c4626fcc40a2c04084650a5d00896632a5209a21adad5a62d67c64dc43a349c",
        "field": "overview",
        "image_license": null,
        "image_sha256": null,
        "match_basis": [
          "TourAPI contentId·명칭·기준좌표 일치"
        ],
        "modality": "TEXT",
