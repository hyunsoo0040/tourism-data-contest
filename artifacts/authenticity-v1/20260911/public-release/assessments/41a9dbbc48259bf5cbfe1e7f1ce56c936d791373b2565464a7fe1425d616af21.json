      "key": "H.d",
      "proposed": {
        "original": {
          "citations": [
            {
              "claim": "HERITAGE_INTERPRETATION",
              "evidence_id": "evidence:284032d8e5835d692407383aa80e5386aa28df23a1a9f66e8d583adf54bdfc4d",
              "quote": {
                "end": 181,
                "method": "EXACT",
                "original": "무덤의 형식은 널무넘(목관묘), 독무덤(옹관묘), 돌무지덧널무덤(적석목곽묘), 굴식돌방무덤(횡혈식석실묘) 등 다양하게 나타난다",
                "start": 111,
                "submitted": "무덤의 형식은 널무넘(목관묘), 독무덤(옹관묘), 돌무지덧널무덤(적석목곽묘), 굴식돌방무덤(횡혈식석실묘) 등 다양하게 나타난다",
                "version": "quote-offset-mapping-v1"
              },
              "record_sha256": "cd3dd8c45ed8f34c0d07ea84399499ea9f283d03d947ea5bc4eb3b4fda3a53e8"
            }
          ],
          "flags": [
            "INFERENCE_SCOPE_REVIEW"
          ],
          "key": "H.d",
          "level": 2,
          "reason": "무덤 형식·출토유물·문화교류에 대한 해설적 설명이 공식 개요에서 제공되나, 현장에서 여러 자료·전시로 심층 탐구할 수 있다는 근거는 없어 2수준(짧은 역사 안내 수준)으로 판단.",
          "state": "SUPPORTED"
        },
        "review": {
          "decision": "REJECTED",
          "issues": [
            "UNSUPPORTED_INFERENCE"
          ],
          "key": "H.d",
          "reason": "인용은 관광 정보 개요의 서술일 뿐 현장에서 제공되는 해설·안내판·전시에 대한 근거가 없다. 2수준 앵커는 '유산·전통에 연결된 설명·전시'의 제공인데, 원문 텍스트가 유적 설명을 담고 있다는 사실만으로 현장 해설 제공을 추정할 수 없어 부적합."
        }
      },
