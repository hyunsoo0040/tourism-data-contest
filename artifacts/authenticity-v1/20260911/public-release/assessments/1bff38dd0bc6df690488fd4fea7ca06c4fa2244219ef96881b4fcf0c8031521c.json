  "judgments": [
    {
      "citations": [],
      "flags": [],
      "key": "H.a",
      "level": null,
      "reason": "공공도서관이라는 시설 소개만 있으며 확인된 실제 원형·유산과의 접촉을 뒷받침하는 근거가 없다. '지적 문화유산 수집·보전' 문구는 도서관 기능 서술일 뿐 방문자가 원형·유산을 경험한다는 근거로 보기 어렵다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.b",
      "level": null,
      "reason": "개관 연도(2003년)와 층별 시설 구성은 있으나, 그 장소 자체의 역사적 사건·인물 맥락을 탐구할 수 있다는 근거는 없다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.c",
      "level": null,
      "reason": "지역주민 대상 도서관 기능은 서술되어 있으나, 지역 주체의 전승·생활문화와의 실제 연결을 확인할 수 있는 근거가 없다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.d",
      "level": null,
      "reason": "독서문화체험 기회 언급은 있으나 원형·유산·전통에 연결된 해설·탐구 프로그램에 대한 구체적 근거가 없다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.a",
      "level": null,
      "reason": "공공도서관으로서의 기능 소개만 있고, 이 장소에 사회적으로 부여된 구체적 이미지·상징적 의미를 확인할 수 있는 근거가 없다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.b",
      "level": null,
      "reason": "매체·작품·홍보물 등을 통한 장소 이미지의 재현·유통에 대한 정보가 제공되지 않았다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.c",
      "level": null,
      "reason": "층별 공간 구성은 있으나 외관·경관·연출 등 시각적 표현의 성격에 대한 근거가 없다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.d",
      "level": null,
      "reason": "대표 장면·구도·이야기를 현장에서 경험하거나 재현할 수 있다는 근거가 없다.",
