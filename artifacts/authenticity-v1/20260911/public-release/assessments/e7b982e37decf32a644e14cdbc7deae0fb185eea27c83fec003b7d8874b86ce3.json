  "judgments": [
    {
      "citations": [],
      "flags": [],
      "key": "H.a",
      "level": null,
      "reason": "개요는 오천항이 예전 충청수영성이 있던 곳임을 언급하지만, 방문자가 확인된 원형·유산 실물이나 공간에 접촉할 수 있는지에 대한 근거는 없다. 수영성은 주변 명소로만 나열되어 있다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.b",
      "level": null,
      "reason": "충청수영성 연혁과 어항으로서의 현재 역할에 대한 간단한 소개가 있으나, 이 장소의 역사·출처를 방문자가 구체적으로 이해할 수 있게 하는 해설·자료에 대한 근거는 부족하다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.c",
      "level": null,
      "reason": "어항으로서의 현재 기능과 특산물(키조개 등) 판매가 언급되어 어업 생활문화의 흔적으로 볼 수 있으나, 지역 주체의 전승·생활문화와의 직접 연결을 확인할 근거는 부족하다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.d",
      "level": null,
      "reason": "원형·유산·전통과 연결된 해설, 전시, 학습 프로그램에 대한 근거가 제공되지 않았다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.a",
      "level": null,
      "reason": "오천항에 부여된 구체적 이미지·이야기의 내용을 확인할 근거가 없다. 예전의 영화가 퇴색했다는 서술은 공유되는 상징적 의미의 경험 지원 요소로 직접 삼기 어렵다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.b",
      "level": null,
      "reason": "작품, 홍보물, 매체를 통한 장소 이미지의 재현·유통에 관한 근거가 없다.",
      "state": "UNKNOWN"
    },
    {
