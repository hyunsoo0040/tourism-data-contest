  "judgments": [
    {
      "citations": [],
      "flags": [],
      "key": "H.a",
      "level": null,
      "reason": "유람선 관광 상품 안내만 있으며 월미도 자체의 확인된 원형·유산에의 접촉을 뒷받침하는 근거가 없다. 인근 교량·도서 경관 감상은 유산 실물 탐구가 아니다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.b",
      "level": null,
      "reason": "제공된 자료에는 이 장소나 유람선의 역사·연혁 서사가 포함되지 않았다. 운항 코스와 요금 안내만 존재한다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.c",
      "level": null,
      "reason": "러시아 무용·서커스 공연은 지역 전통·생활문화의 전승과의 연결을 보여주지 않는다. 실제 전승 활동 관련 근거가 없다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.d",
      "level": null,
      "reason": "유산·전통에 연결된 해설·전시·탐구 프로그램에 대한 근거가 없다. 코스 안내는 역사 해설이 아니다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.a",
      "level": null,
      "reason": "가족 여행·연인 데이트 코스라는 소개 문구는 있으나 장소에 사회적으로 부여된 구체적 상징·의미의 내용을 확인하기에는 불충분하다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.b",
      "level": null,
      "reason": "작품·홍보 매체·SNS 등을 통한 장소 이미지의 재현·유통에 대한 근거가 제공되지 않았다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.c",
      "level": null,
      "reason": "anchor_ko는 '장면에서 구별되는 시각적 성격'(수준 3)이지만 제시된 근거와 판단 사유는 모두 '제한된 색·빛의 표현'(수준 2) 수준만을 설명한다. 불꽃과 교량 야경 언급은 제한적 색·빛 표현 근거일 뿐, 장면에서 구별되는 시각적 성격이라는 현재 제안 수준을 직접 뒷받침하지 않는다.",
