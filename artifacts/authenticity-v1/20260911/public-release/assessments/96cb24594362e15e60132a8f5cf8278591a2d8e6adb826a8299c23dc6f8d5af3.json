      "key": "E.c",
      "proposed": {
        "basis": "DIRECT_SUPPORT",
        "citations": [
          {
            "claim": "VISUAL_APPEARANCE",
            "evidence_id": "evidence:cdf4efb1dbeaeac782eb57c1695a08161b0908c17d07c4398cae35d004d53f03",
            "quote": "대성암을 지나 바위로 된 계곡을 따라 올라가면 범어사 팔경 중 한 곳인 금강만풍으로 잘 알려진 금강암이 나온다."
          }
        ],
        "key": "E.c",
        "level": 2,
        "reason": "바위 계곡과 암자의 경관 등 시각적 성격에 대한 제한적 묘사가 있다. '금강만풍'이라는 경관 명칭이 시각적 표현의 존재를 시사하나, 그 표현의 강도나 장면 지배 여부에 대한 구체적 근거가 부족해 수준 2로 제한적으로 판단한다.",
        "state": "SUPPORTED",
        "subject": "THIS_PLACE"
      },
      "reason": "SOURCE_CLAIM_FACET_NOT_AUTHORIZED"
    },
    {
      "code": "AI_SEMANTIC_UNCERTAIN",
      "key": "R.a",
      "proposed": {
        "original": {
          "citations": [
            {
              "claim": "AUTONOMOUS_ACTIVITY",
              "evidence_id": "evidence:cdf4efb1dbeaeac782eb57c1695a08161b0908c17d07c4398cae35d004d53f03",
              "quote": {
                "end": 489,
                "method": "EXACT",
                "original": "범어사 왼쪽의 금정산 북문 방향으로 가다 보면, 범어사 대성암이 나오고 대성암을 지나 바위로 된 계곡을 따라 올라가면",
                "start": 424,
                "submitted": "범어사 왼쪽의 금정산 북문 방향으로 가다 보면, 범어사 대성암이 나오고 대성암을 지나 바위로 된 계곡을 따라 올라가면",
                "version": "quote-offset-mapping-v1"
              },
              "record_sha256": "cd6eabe53b50548f292b035d881cbfeb02025209c4d7a92941da48ffcfd05591"
            }
          ],
          "flags": [
            "INFERENCE_SCOPE_REVIEW"
          ],
          "key": "R.a",
          "level": 2,
          "reason": "계곡길을 따라 대성암을 거쳐 도보로 올라가는 동선이 묘사되어 산책형 자율 탐색의 여지를 시사한다. 다만 자유로운 탐색·머무름이 경험의 중심이라는 근거는 없고 동선 묘사가 제한적이어서 수준 2로 판단한다.",
          "state": "SUPPORTED"
        },
        "review": {
          "decision": "UNCERTAIN",
          "issues": [
            "INSUFFICIENT_CONTEXT"
          ],
          "key": "R.a",
          "reason": "anchor_ko는 수준 3 '자율적으로 선택·탐색할 기회'인데, 근거는 도보 동선 묘사뿐이며 검토 사유 스스로 수준 2(짧고 제한된 자유 선택)를 주장한다. 계곡길 등산 동선이 자율 탐색 기회를 어느 수준까지 지원하는지 판단할 추가 근거가 없어 상위 수준을 확정할 수 없다."
        }
      },
