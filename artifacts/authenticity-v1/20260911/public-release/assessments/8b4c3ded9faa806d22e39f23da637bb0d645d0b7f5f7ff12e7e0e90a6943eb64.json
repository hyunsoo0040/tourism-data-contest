      "key": "H.d",
      "proposed": {
        "original": {
          "citations": [
            {
              "claim": "HERITAGE_INTERPRETATION",
              "evidence_id": "evidence:5ec89f86cfcb6efeb44a482e657ad82afad3ffd3c9e793c60f8fba96aba58d74",
              "quote": {
                "end": 300,
                "method": "EXACT",
                "original": "캡슐에는 정치, 경제, 사회, 문화 등 현재 생활의 모든 것을 보여줄 문물 600여 점이 수장되어 있다",
                "start": 243,
                "submitted": "캡슐에는 정치, 경제, 사회, 문화 등 현재 생활의 모든 것을 보여줄 문물 600여 점이 수장되어 있다",
                "version": "quote-offset-mapping-v1"
              },
              "record_sha256": "118142ff8616c9df495092261c7340842a18ce525877826c44f0196f7852740d"
            }
          ],
          "flags": [
            "INFERENCE_SCOPE_REVIEW"
          ],
          "key": "H.d",
          "level": 3,
          "reason": "수장품의 구성과 의미, 시간의 순환을 상징하는 12개 기둥 등 유산과 연결된 해설 내용이 공식 개요에서 제공된다. 그러나 현장에서의 해설·전시·탐구 프로그램 존재는 명시되지 않아 깊은 탐구가 중심이라 보기 어렵다.",
          "state": "SUPPORTED"
        },
        "review": {
          "decision": "UNCERTAIN",
          "issues": [
            "INSUFFICIENT_CONTEXT"
          ],
          "key": "H.d",
          "reason": "원문은 캡슐 수장품의 구성과 의미를 설명하지만 이것이 현장에서 방문자가 이용할 수 있는 해설·전시·탐구 자료임을 명시하지 않는다. 공식 소개글의 서술만으로 현장 해설의 존재와 수준(수준 3)을 확정하기 어렵다."
        }
      },
      "reason": "원문은 캡슐 수장품의 구성과 의미를 설명하지만 이것이 현장에서 방문자가 이용할 수 있는 해설·전시·탐구 자료임을 명시하지 않는다. 공식 소개글의 서술만으로 현장 해설의 존재와 수준(수준 3)을 확정하기 어렵다."
    }
