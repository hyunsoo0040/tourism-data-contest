  "judgments": [
    {
      "citations": [],
      "flags": [],
      "key": "H.a",
      "level": null,
      "reason": "제안 수준(앵커: '확인된 원형·유산을 관람')은 세덕사·숭덕재 건물 관람으로 뒷받침되나, 원 서원은 1868년 철폐되었고 1994년 확대 개축되어 현존 건물이 원형 유산인지 재현·개축물인지 자료만으로 구분되지 않는다. 원형·복원·재현 구분이 불명확하여 확정하기 어렵다.",
      "state": "REJECTED"
    },
    {
      "citations": [
        {
          "claim": "HISTORICAL_NARRATIVE",
          "evidence_id": "evidence:f8bf924d76d1138a8d5954b42540c75e200325fd42cd018e62cbe6d6670d06e5",
          "quote": {
            "end": 183,
            "method": "EXACT",
            "original": "1794년 정충사에서 다른 분을 추향 하게 되어 그해 9월에 이곳으로 이봉(移封)하면서 반암서원이라 현판(懸板)하였다.",
            "start": 117,
            "submitted": "1794년 정충사에서 다른 분을 추향 하게 되어 그해 9월에 이곳으로 이봉(移封)하면서 반암서원이라 현판(懸板)하였다.",
            "version": "quote-offset-mapping-v1"
          },
          "record_sha256": "3b616a82cf8b756470b5537ebbd9d04aab01767d69e382e1ffc635fb4c176ed3"
        }
      ],
      "flags": [
        "INFERENCE_SCOPE_REVIEW"
      ],
      "key": "H.b",
      "level": 2,
      "reason": "정구 봉안, 이봉, 서원철폐령에 의한 철폐 등 이 장소의 구체적 연혁이 공식 개요에 제시되어 역사 맥락 소개 수준은 지원된다. 방문 경험 중심의 탐구라는 근거는 없어 중간 수준에 머문다.",
      "state": "SUPPORTED"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.c",
      "level": null,
      "reason": "서원이라는 유형과 의례 공간 활용 언급은 있으나 지역 주체의 현재 전승·제례·생활문화 활동이 실제 지속된다는 근거는 제공되지 않았다. 외관이나 유형만으로 전승을 추정하지 않는다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.d",
      "level": null,
      "reason": "건물 구조에 대한 설명이 존재하나 이것이 현장에서 방문자에게 제공되는 해설·전시·탐구 프로그램인지에 대한 근거가 없다. 평가 문서의 서술은 현장 해설의 증거가 아니다.",
      "state": "UNKNOWN"
    },
    {
