                "version": "quote-offset-mapping-v1"
              },
              "record_sha256": "4153ab8c62b347d929d096c7022caf21a7fa76f5963b9f536800fd03983ca85e"
            }
          ],
          "flags": [
            "INFERENCE_SCOPE_REVIEW"
          ],
          "key": "E.c",
          "level": 2,
          "reason": "벽화, 맞배지붕 주심포 익공계 건물 등 제한적이지만 확인되는 시각적 표현 요소가 있다. 경관이 장면을 지배한다는 근거는 없어 수준 2로 판단한다.",
          "state": "SUPPORTED"
        },
        "review": {
          "decision": "UNCERTAIN",
          "issues": [
            "INSUFFICIENT_CONTEXT"
          ],
          "key": "E.c",
          "reason": "벽화와 전통 건물 양식은 시각적 표현의 근거가 되나, 제시된 앵커는 '장면에서 구별되는 시각적 성격'(수준 3)인 반면 판단 사유는 수준 2(제한된 색·빛·형태의 표현)로 결론 내리고 있어 앵커와 논거가 불일치한다. 단일 벽화 언급만으로 장면에서 구별되는 시각적 성격을 단정하기 어려워 UNCERTAIN으로 남긴다."
        }
      },
      "reason": "벽화와 전통 건물 양식은 시각적 표현의 근거가 되나, 제시된 앵커는 '장면에서 구별되는 시각적 성격'(수준 3)인 반면 판단 사유는 수준 2(제한된 색·빛·형태의 표현)로 결론 내리고 있어 앵커와 논거가 불일치한다. 단일 벽화 언급만으로 장면에서 구별되는 시각적 성격을 단정하기 어려워 UNCERTAIN으로 남긴다."
