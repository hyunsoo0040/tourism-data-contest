    {
      "code": "AI_SEMANTIC_UNCERTAIN",
      "key": "E.c",
      "proposed": {
        "original": {
          "citations": [
            {
              "claim": "VISUAL_EXPRESSION",
              "evidence_id": "evidence:93a28981e5700742dca135a3b96c08f5718324a907a3ce0cab1a2cb482c117f8",
              "quote": {
                "end": 243,
                "method": "EXACT",
                "original": "여수반도와 순천 지역을 연결하는 길목에 있고 광양만이 눈앞에 보이는 요새 지역이다.",
                "start": 197,
                "submitted": "여수반도와 순천 지역을 연결하는 길목에 있고 광양만이 눈앞에 보이는 요새 지역이다.",
                "version": "quote-offset-mapping-v1"
              },
              "record_sha256": "4bdc329d5dd03780d419096b655ecf62dce9d64d688e1695f302a8d67d42c9cb"
            }
          ],
          "flags": [
            "INFERENCE_SCOPE_REVIEW"
          ],
          "key": "E.c",
          "level": 2,
          "reason": "광양만이 눈앞에 보이는 전망 등 제한된 시각적 경관 표현이 언급된다. 그러나 일관된 외관·연출이 장면을 지배한다는 근거는 없어 2 수준이다.",
          "state": "SUPPORTED"
        },
        "review": {
          "decision": "UNCERTAIN",
          "issues": [
            "INSUFFICIENT_CONTEXT"
          ],
          "key": "E.c",
          "reason": "인용문은 광양만 전망과 요새 지역이라는 입지 서술로, 시각적 표현·연출에 대한 직접 확인이라기보다 지리적 가치 기술이다. 앵커 '장면에서 구별되는 시각적 성격'(3)을 이 한 문장으로 뒷받침하기엔 부족하며, 판단 사유도 스스로 일관된 연출의 근거가 없다고 인정해 앵커와 불일치한다."
        }
      },
      "reason": "인용문은 광양만 전망과 요새 지역이라는 입지 서술로, 시각적 표현·연출에 대한 직접 확인이라기보다 지리적 가치 기술이다. 앵커 '장면에서 구별되는 시각적 성격'(3)을 이 한 문장으로 뒷받침하기엔 부족하며, 판단 사유도 스스로 일관된 연출의 근거가 없다고 인정해 앵커와 불일치한다."
