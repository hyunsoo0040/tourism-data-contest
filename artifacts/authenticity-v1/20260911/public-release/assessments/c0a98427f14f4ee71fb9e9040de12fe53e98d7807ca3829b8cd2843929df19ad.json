              "record_sha256": "c34f03a642c5106d36faec8d77d5cc98a32d0d8f1701b0372487f248d1103b45"
            }
          ],
          "flags": [
            "INFERENCE_SCOPE_REVIEW"
          ],
          "key": "H.a",
          "level": 3,
          "reason": "현존 국보·보물 지정 문화재와 15동의 건물을 갖춘 사찰로, 방문자가 실제 원형·유산(괘불탱화, 제석천왕·대범천왕, 3층 석탑 등)을 관람할 수 있는 근거가 직접 제시된다. 실물 탐구가 경험의 중심이라는 근거까지는 없어 3수준으로 판단한다.",
          "state": "SUPPORTED"
