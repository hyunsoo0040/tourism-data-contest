              "record_sha256": "1dd8c8ace94202e0b37f97bde05059310c35eaa4b969250435888820067e8515"
            }
          ],
          "flags": [],
          "key": "H.d",
          "level": 3,
          "reason": "건축 양식(절충식, 이오니아 양식, 르네상스식 창), 설계자, 재료 등 유산에 연결된 해설 내용이 공식 개요에 제시되어 역사·건축 맥락의 학습이 가능하다. 다양한 자료를 통한 심층 탐구까지만 확인되므로 최상위는 아니다.",
          "state": "SUPPORTED"
        },
        "review": {
