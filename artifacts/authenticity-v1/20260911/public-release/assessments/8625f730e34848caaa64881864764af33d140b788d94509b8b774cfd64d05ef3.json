                "version": "quote-offset-mapping-v1"
              },
              "record_sha256": "6088de6a1d55f2efa470d4f329056c14cff84923e59b35e8fb7d03f0a967d05c"
            }
          ],
          "flags": [
            "INFERENCE_SCOPE_REVIEW"
          ],
          "key": "H.c",
          "level": 2,
          "reason": "박물관 주변 옛길 유적이 현재도 살아있는 길로 이용된다고 공식 개요가 밝히고 있으나, 박물관 자체의 전승은 전시를 통한 소개 수준이며 지역 주체의 지속 활동을 직접 경험시킨다는 근거는 없어 2수준이다.",
          "state": "SUPPORTED"
        },
        "review": {
          "decision": "UNCERTAIN",
          "issues": [
            "MARKETING_AS_FIELD_FACT",
            "INSUFFICIENT_CONTEXT"
          ],
          "key": "H.c",
          "reason": "제시된 인용은 개요의 서술로 옛길이 '살아있는 길'로 즐겨 찾는다는 표현이며, 이는 인근 새재·고갯길에 관한 서술로 현재 박물관 방문 경험에서 지역 주체의 전승·생활문화를 관람한다는 것을 직접 뒷받침하지 않는다. 전시실의 의·식·주·신앙 내용은 과거 생활문화의 전시이지 현재 전승 활동의 관람이라 단정하기 어렵다."
        }
      },
      "reason": "제시된 인용은 개요의 서술로 옛길이 '살아있는 길'로 즐겨 찾는다는 표현이며, 이는 인근 새재·고갯길에 관한 서술로 현재 박물관 방문 경험에서 지역 주체의 전승·생활문화를 관람한다는 것을 직접 뒷받침하지 않는다. 전시실의 의·식·주·신앙 내용은 과거 생활문화의 전시이지 현재 전승 활동의 관람이라 단정하기 어렵다."
