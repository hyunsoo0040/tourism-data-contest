                "version": "quote-offset-mapping-v1"
              },
              "record_sha256": "22781a88370b6c1ff32c8b33666fa2dd933966c41c915d230917f1118adec6d9"
            }
          ],
          "flags": [
            "INFERENCE_SCOPE_REVIEW"
          ],
          "key": "R.d",
          "level": 3,
          "reason": "관광통역안내사와의 상담, 예술 결합형 아트투어 등 교류 기회가 명시되어 있다. 다만 자기표현·공동 창작 활동의 깊이에 대한 근거는 부족하여 구체적 교류 기회 수준으로 평가한다.",
          "state": "SUPPORTED"
        },
        "review": {
          "decision": "REJECTED",
          "issues": [
            "UNSUPPORTED_INFERENCE"
          ],
          "key": "R.d",
          "reason": "관광통역안내사 상담은 서비스 이용이지 공동 활동·자기표현 기회가 아니며, 아트투어의 공동 창작 성격도 근거가 없다. '함께 만들거나 자신을 표현할 활동이 풍부'(수준 3)는 뒷받침되지 않는다. 제한된 공동 활동 수준이 상한이다."
        }
      },
      "reason": "관광통역안내사 상담은 서비스 이용이지 공동 활동·자기표현 기회가 아니며, 아트투어의 공동 창작 성격도 근거가 없다. '함께 만들거나 자신을 표현할 활동이 풍부'(수준 3)는 뒷받침되지 않는다. 제한된 공동 활동 수준이 상한이다."
