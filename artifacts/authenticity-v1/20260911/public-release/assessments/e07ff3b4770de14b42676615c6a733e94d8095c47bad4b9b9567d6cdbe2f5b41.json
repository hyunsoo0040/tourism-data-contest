  "judgments": [
    {
      "citations": [],
      "flags": [],
      "key": "H.a",
      "level": null,
      "reason": "장서각이 조선 왕실 고문헌과 민간 고문헌을 소장한다는 사실은 확인되나, 방문자가 실물·원형에 접촉하거나 관람할 수 있다는 근거는 제공되지 않는다. 소장·연구 기능만 언급되어 접촉 경험 지원 여부를 판단할 수 없다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [
        {
          "claim": "HISTORICAL_NARRATIVE",
