  "judgments": [
    {
      "citations": [],
      "flags": [],
      "key": "H.a",
      "level": null,
      "reason": "제안 앵커는 '원형·유산의 공간이나 실물을 구체적으로 탐구'(수준 4)이다. 근거는 보물 지정 마애불의 실재와 현장 관람 가능성까지만 뒷받침하며(수준 3), 방문자가 공간·실물을 탐구하는 경험의 근거는 없다. 제안 사유 자체도 탐구 중심 여부 미확인을 인정하므로 해당 앵커는 미지원이다.",
      "state": "REJECTED"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.b",
      "level": null,
      "reason": "제안 앵커는 '여러 맥락을 대상과 연결해 설명'(수준 4)이다. 801년 절대 연대, 보물 지정, 양식사적 비교 등 이 장소 불상의 구체적 역사 맥락 제시는 수준 3까지만 뒷받침하며, 여러 맥락을 연결한 설명 체계나 현장 제공 여부의 근거가 없다.",
      "state": "REJECTED"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.c",
      "level": null,
      "reason": "마애사라는 사찰과 불상의 존재는 확인되나, 지역 주체의 현재 전승·생활문화 활동에 대한 근거가 없다. 역사적 유물이라는 사실만으로 실제 전승의 지속을 추정하지 않는다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
