          "response_sha256": "cc43b899c44aa4f45a915366a291699c59d74c99111d339562ed328b5adcd645",
          "retrieved_at": "2026-09-10T07:39:15.646532Z",
          "schema_version": "authenticity-receipt.v1",
          "source_modified_at": "2025-12-18T02:23:45Z",
          "source_record_sha256": "5591d706278f5398407f19f873a13699684b0a52e023484fbb8b44f0cadd9771",
