  "judgments": [
    {
      "citations": [],
      "flags": [],
      "key": "H.a",
      "level": null,
      "reason": "개요는 2018년 신축 건물과 전시실·영화관 등 시설을 소개할 뿐, 확인된 실제 원형·유산(유물, 사적 공간 등)과의 접촉을 방문자가 경험할 수 있다는 근거가 없다. 신축 건물 자체는 유산 접촉의 증거가 아니다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.b",
      "level": null,
      "reason": "철원향토사 연구소가 2층에 자리한다는 시설 정보만 있을 뿐, 방문자가 이 장소의 구체적 역사·연혁 맥락을 이해할 수 있는 해설이나 전시 내용에 대한 근거가 없다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.c",
      "level": null,
      "reason": "근거는 전승 흔적에 대한 제한적 접촉(하위 수준)까지 뒷받침하며, 제안된 앵커 '확인된 전승·생활문화를 관람' 수준에서 방문자가 실제 전승 활동을 관람한다는 근거는 없다. 프로그램이 관내 주민 대상이라는 점도 관람 가능성을 불명확하게 만든다.",
      "state": "REJECTED"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.d",
      "level": null,
      "reason": "제시된 앵커는 '유산·전통에 연결된 설명·전시'이나, 전시실은 '다양한 주제'로만 확인되어 전통·유산 해설과의 연결이 검증되지 않는다. 향토사 연구소의 존재만으로 유산 연계 설명·전시를 단정하기 어렵고, 판단자 스스로 '짧은 안내 수준'으로 제한하고 있다.",
      "state": "REJECTED"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.a",
      "level": null,
      "reason": "개요는 시설·프로그램 소개에 그치며, 이 장소에 사회적으로 부여된 특정 이미지나 상징적 의미가 확인되지 않는다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
