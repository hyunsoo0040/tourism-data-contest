  "judgments": [
    {
      "citations": [],
      "flags": [],
      "key": "H.a",
      "level": null,
      "reason": "활성산성 토성 흔적이 일부 남아 있다는 사실은 원형과의 제한적 접촉(수준 2)까지는 뒷받침한다. 그러나 제안된 앵커 '확인된 원형·유산을 관람'(수준 3)은 흔적의 실제 관람 가능성·접근성에 대한 근거가 없어 뒷받침되지 않는다.",
      "state": "REJECTED"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.b",
      "level": null,
      "reason": "산 명칭이 활성산성에서 유래했다는 단순 연혁 소개는 수준 2(관련 연혁·유래를 간단히 소개)에 해당한다. 제안된 앵커 '그 장소의 사건·인물 맥락 제시'(수준 3)에 필요한 구체적 사건·인물 맥락의 제시는 근거가 없다.",
      "state": "REJECTED"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.c",
      "level": null,
      "reason": "지역 주체의 전승·생활문화와의 연결에 대한 언급이 없다. 서광목장 초지가 태양광 패널로 대치되었다는 서술은 오히려 과거 목축 경관의 변화를 시사할 뿐 현재 전승 활동의 근거가 되지 않는다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.d",
      "level": null,
      "reason": "성터나 지역 역사에 연결된 해설·전시·학습 프로그램에 대한 근거가 없다. 개요의 서술은 안내 해설 제공을 의미하지 않는다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.a",
      "level": null,
      "reason": "'이질적이고 이국적인' 경관 표현은 장소에 연결된 간단한 이미지 표현(수준 2) 수준이다. 제안된 앵커 '구체적인 이미지·이야기가 장소와 연결'(수준 3)에 필요한 구체적 이야기·이미지의 반복적 연결 근거는 부족하다.",
      "state": "REJECTED"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.b",
      "level": null,
      "reason": "작품, 홍보물, SNS 등 매체를 통한 장소 이미지의 재현·유통에 대한 근거가 제공되지 않았다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.c",
      "level": null,
      "reason": "태양광 패널과 풍력발전기가 어우러진 경관은 장면에서 구별되는 시각적 성격(수준 3)을 뒷받침한다. 그러나 제안된 앵커 '분명한 외관·경관·연출의 표현'(수준 4)은 일관된 연출이 장면을 지배한다는 요구가 있고 이를 뒷받침하는 근거는 없다.",
      "state": "REJECTED"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.d",
      "level": null,
      "reason": "대표 장면·구도·이야기를 현장에서 체험하거나 재현(촬영 포인트 등)할 수 있다는 명시적 근거가 없다. 조망 경관 묘사만으로 이미지 재현 경험을 추정하지 않는다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "R.a",
      "level": null,
      "reason": "사유지 출입 통제로 자율 탐색이 부분 제한되므로 제안된 앵커 '자율적으로 선택·탐색할 기회'(수준 3)보다는 제한된 자유 선택(수준 2)에 가깝다. 수준 3을 직접 뒷받침하는 근거가 부족하다.",
      "state": "REJECTED"
    },
    {
      "citations": [],
      "flags": [],
      "key": "R.b",
      "level": null,
      "reason": "산지·수목·조망 등 자연 환경 단서는 확인되나 프로펠러 소음과 초지의 태양광 대치가 명시되어 시각적 저자극 환경이 두드러진다(수준 4)는 제안 앵커를 뒷받침하지 않는다. 자연 환경 단서 확인(수준 3)까지만 근거가 있다.",
