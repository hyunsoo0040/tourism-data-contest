  "judgments": [
    {
      "citations": [],
      "flags": [],
      "key": "H.a",
      "level": null,
      "reason": "제공된 개관 설명은 2005년 개관한 공연장·전시실·회의실 등 복합 문화시설의 시설 현황만 담고 있으며, 확인된 원형·유산과의 접촉에 관한 근거가 없다. '세계문화유산 융건릉' 등은 인근 관광지 나열일 뿐 이 장소의 경험이 아니므로 옮겨 평가하지 않는다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.b",
      "level": null,
      "reason": "개관 연도와 운영 주체(용인문화재단) 등 행정적 연혁만 언급되어 있을 뿐, 이 장소의 실제 역사·사건·인물 맥락을 탐구할 수 있다는 근거가 없다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.c",
      "level": null,
      "reason": "지역 주체의 전승·생활문화와의 실제 연결에 관한 설명이 없다. 문화재단 산하 단체 입주 사실만으로 살아있는 전승 활동이라 단정할 수 없다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "H.d",
      "level": null,
      "reason": "원형·유산·전통에 연결된 해설·전시·학습 프로그램에 관한 근거가 없다. 공연·회의·도서관 시설 안내만 제공된다.",
      "state": "UNKNOWN"
    },
    {
      "citations": [],
      "flags": [],
      "key": "E.a",
      "level": null,
      "reason": "'온 가족이 편안하게 드나들며 문화생활을 영유하는 공간'이라는 표현이 있으나, 이는 운영 목적 서술이며 사회적으로 공유되는 구체적 상징·의미의 내용을 확인할 근거는 부족하다.",
      "state": "UNKNOWN"
    },
    {
