          "provider_record_id": "1492402",
          "request_sha256": "d44bff4019bdbfe5a9c6785f4cdf90fd31e8c312faf58b67c6cc9bb297b8d9c9",
          "response_sha256": "75cebb374717804a9af4ff471aa0ce9a64a27860c4b459c616e2f5e498304b93",
          "retrieved_at": "2026-09-10T17:04:45.880772Z",
          "schema_version": "authenticity-receipt.v1",
